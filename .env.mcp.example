# MCP-only credentials and endpoints.
# Copy to `.env.mcp` when you want agent tooling without touching your app `.env`.

DAISYUI_BLUEPRINT_EMAIL=you@example.com
DAISYUI_BLUEPRINT_LICENSE=your_daisyui_blueprint_license_here
RENDER_API_KEY=your_render_api_key_here
ROLLBAR_ACCESS_TOKEN=your_rollbar_access_token_here
TIDEWAVE_MCP_URL=http://localhost:3000/tidewave/mcp
